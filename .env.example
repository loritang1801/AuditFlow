# Local persistence used by scripts/run_api.py and the local helper scripts.
AUDITFLOW_DATABASE_URL=sqlite+pysqlite:///./.local/auditflow.db

# Default to the vendored shared runtime in this repo.
AUDITFLOW_SHARED_CORE_SOURCE=vendored

# Local auth secret for development only.
AUDITFLOW_AUTH_SECRET=auditflow-dev-secret

# Optional OpenAI runtime.
# OPENAI_API_KEY=
# AUDITFLOW_MODEL_PROVIDER=openai
# AUDITFLOW_OPENAI_MODEL=gpt-5.4-mini
# AUDITFLOW_EMBEDDING_PROVIDER=openai
# AUDITFLOW_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional remote connector configuration.
# AUDITFLOW_JIRA_PROVIDER=auto
# AUDITFLOW_JIRA_URL_TEMPLATE=https://jira.example.test/rest/api/3/search?jql={query}
# AUDITFLOW_JIRA_AUTH_TOKEN=
# AUDITFLOW_CONFLUENCE_PROVIDER=auto
# AUDITFLOW_CONFLUENCE_URL_TEMPLATE=https://confluence.example.test/wiki/rest/api/search?cql={query}
# AUDITFLOW_CONFLUENCE_AUTH_TOKEN=
